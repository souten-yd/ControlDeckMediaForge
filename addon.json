{
  "api_version": "2",
  "id": "media-forge",
  "name": "Media Forge",
  "version": "0.28.73",
  "description": "Local-first media generation and asset library",
  "publisher": "souten-yd",
  "requires": {
    "addon_contract": ">=2.0 <3.0"
  },
  "runtime": {
    "kind": "external-service",
    "base_url": "http://127.0.0.1:9130",
    "health_path": "/health"
  },
  "host_capabilities": [
    "context.read",
    "theme.read",
    "route.open",
    "files.pick",
    "files.export",
    "projects.pick",
    "jobs.read",
    "jobs.write",
    "notifications.show",
    "resources.acquire",
    "ai.inference"
  ],
  "contributions": {
    "navigation": [
      {
        "id": "workspace",
        "label": {
          "en": "Media",
          "ja": "Media"
        },
        "route": "/x/media-forge/workspace",
        "icon": "images"
      }
    ],
    "embedded_views": [
      {
        "id": "workspace",
        "label": "Media Forge",
        "route": "/x/media-forge/workspace",
        "path": "/",
        "mobile": "embedded"
      }
    ],
    "commands": [
      {
        "id": "create-media",
        "label": {
          "en": "Create media",
          "ja": "メディアを作成"
        },
        "endpoint": "/addon/v1/commands/create"
      }
    ],
    "settings": [
      {
        "id": "settings",
        "label": {
          "en": "Media Forge Settings",
          "ja": "Media Forge 設定"
        },
        "route": "/x/media-forge/workspace/settings",
        "permission": "settings.manage"
      }
    ],
    "workflow_executors": [
      {
        "id": "media.generate",
        "label": {
          "en": "Generate media",
          "ja": "メディア生成"
        },
        "endpoint": "/addon/v1/workflow/execute",
        "input_schema_path": "/schemas/job-request.json",
        "output_schema_path": "/schemas/job-reference.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.scene",
        "label": {
          "en": "Run a typed 3D scene recipe",
          "ja": "型付き 3D シーン recipe を実行"
        },
        "endpoint": "/addon/v1/workflow/media.scene/execute",
        "input_schema_path": "/schemas/scene-workflow-request.json",
        "output_schema_path": "/schemas/job-reference.json",
        "permission": "workflows.run"
      }
    ],
    "agent_tools": [
      {
        "id": "media.capabilities",
        "label": "List the media models and features available now",
        "endpoint": "/addon/v1/agent/capabilities",
        "schema_path": "/schemas/empty-input.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.generate",
        "label": "Generate media",
        "endpoint": "/addon/v1/agent/generate",
        "schema_path": "/schemas/job-request.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.generate.batch",
        "label": "Generate several media assets",
        "endpoint": "/addon/v1/agent/generate/batch",
        "schema_path": "/schemas/media-generate-batch.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.inspect",
        "label": "Read back what a finished media asset is",
        "endpoint": "/addon/v1/agent/inspect",
        "schema_path": "/schemas/asset-reference.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.pack",
        "label": "Place a media asset in the current project",
        "endpoint": "/addon/v1/agent/pack",
        "schema_path": "/schemas/project-asset-placement.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.scene.create",
        "label": "Create a 3D scene",
        "endpoint": "/addon/v1/agent/scene/create",
        "schema_path": "/schemas/scene-create-request.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.scene.edit",
        "label": "Edit an existing 3D scene",
        "endpoint": "/addon/v1/agent/scene/edit",
        "schema_path": "/schemas/scene-edit-request.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.scene.material",
        "label": "Change a material on a 3D scene",
        "endpoint": "/addon/v1/agent/scene/material",
        "schema_path": "/schemas/scene-material-request.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.scene.snapshot",
        "label": "Read back the current state of a 3D scene",
        "endpoint": "/addon/v1/agent/scene/snapshot",
        "schema_path": "/schemas/scene-reference.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.scene.export",
        "label": "Export a 3D scene as GLB or Blender",
        "endpoint": "/addon/v1/agent/scene/export",
        "schema_path": "/schemas/scene-export-request.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.job.status",
        "label": "Check whether a 3D scene job has finished",
        "endpoint": "/addon/v1/agent/job/status",
        "schema_path": "/schemas/scene-job-status-request.json",
        "permission": "workflows.run"
      },
      {
        "id": "media.job.cancel",
        "label": "Cancel a running 3D scene job",
        "endpoint": "/addon/v1/agent/job/cancel",
        "schema_path": "/schemas/scene-job-cancel-request.json",
        "permission": "workflows.run"
      }
    ],
    "context_actions": [
      {
        "id": "edit-image",
        "label": {
          "en": "Edit in Media Forge",
          "ja": "Media Forge で編集"
        },
        "endpoint": "/addon/v1/context/edit-image",
        "contexts": [
          "file",
          "project"
        ],
        "permission": "project_lab.view"
      }
    ],
    "setup_checklist": [
      {
        "id": "core",
        "label": {
          "en": "Media Forge service",
          "ja": "Media Forge サービス"
        },
        "permission": "settings.manage"
      }
    ]
  }
}
