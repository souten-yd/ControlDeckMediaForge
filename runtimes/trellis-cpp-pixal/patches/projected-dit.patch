+// GGML CPU GELU uses an FP16 lookup by default. This opt-in graph evaluates
+// the same tanh approximation as PyTorch in F32, without the lookup rounding.
+static T* gelu_f32(ggml_context* c, T* x) {
+    T* cubic = ggml_mul(c, ggml_mul(c, x, x), x);
+    T* inner = ggml_add(c, x, ggml_scale(c, cubic, 0.044715f));
+    T* tanh_value = ggml_tanh(c, ggml_scale(c, inner, 0.7978845608028654f));
+    // 0.5*x*(1+tanh) without a backend scalar input or broadcast constant.
+    return ggml_scale(c, ggml_add(c, x, ggml_mul(c, x, tanh_value)), 0.5f);
+}
+
 // x*(1+scale)+shift, scale/shift: [d_model] broadcast over L
