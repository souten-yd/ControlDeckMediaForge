+std::vector<float> pixal_sample_pbr(const VoxelPbr& vox, const std::vector<float>& points) {
+    VoxSampler sampler(vox);
+    std::vector<float> out(points.size()/3*6, 0.f);
+    for (size_t i=0;i<points.size()/3;++i) {
+        if (!sampler.sample(points.data()+3*i,out.data()+6*i))
+            throw std::runtime_error("Pixal surface projection failed");
+    }
+    return out;
+}
