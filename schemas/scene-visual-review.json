{
  "$defs": {
    "ReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "object",
            "scene",
            "reference"
          ],
          "title": "Scope",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Object Id"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^(observation\\.(front|side|back|three-quarter)|reference\\.(front|side|back|three-quarter|canonical))$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "description": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "expected_improvement": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Expected Improvement",
          "type": "string"
        },
        "suggested_operation": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Suggested Operation"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "scope",
        "object_id",
        "evidence_ids",
        "description",
        "expected_improvement",
        "suggested_operation",
        "confidence"
      ],
      "title": "ReviewIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "enum": [
        "issues_found",
        "no_visible_issues",
        "inconclusive"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "reference_consistency": {
      "enum": [
        "consistent",
        "contradictory",
        "uncertain",
        "not_provided"
      ],
      "title": "Reference Consistency",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ReviewIssue"
      },
      "maxItems": 3,
      "title": "Issues",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "verdict",
    "reference_consistency",
    "issues",
    "limitations"
  ],
  "title": "VisualReview",
  "type": "object"
}
