            }
          ],
          "title": "Radii",
          "type": "array"
        }
      },
      "required": [
        "center",
        "radii"
      ],
      "title": "CurveSection",
      "type": "object"
    },
    "MeshSectionsSet": {
      "additionalProperties": false,
      "description": "Replace all control sections, preserving vertex/face order, weights and UVs.\nRequires an unchanged procedural mesh and its actual geometry hash. The number\nof sections and sampling settings cannot change through this operation.",
      "properties": {
        "type": {
          "const": "mesh.sections.set",
          "title": "Type",
          "type": "string"
        },
        "object_id": {
          "description": "Stable recipe object ID used by all later operations; it is not a Blender name.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "expected_geometry_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Geometry Sha256",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/CurveSection"
          },
          "maxItems": 32,
          "minItems": 2,
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "type",
        "object_id",
        "expected_geometry_sha256",
        "sections"
      ],
      "title": "MeshSectionsSet",
      "type": "object"
    },
    "TransformSet": {
      "additionalProperties": false,
      "description": "Replace one or more transforms on an existing stable object ID.",
      "properties": {
        "type": {
          "const": "transform.set",
          "title": "Type",
          "type": "string"
        },
        "object_id": {
          "description": "Stable recipe object ID used by all later operations; it is not a Blender name.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "dimensions": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 1000,
                  "type": "number"
                },
                {
                  "exclusiveMinimum": 0,
                  "maximum": 1000,
                  "type": "number"
                },
                {
                  "exclusiveMinimum": 0,
                  "maximum": 1000,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimensions"
        },
        "location": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 10000,
                  "minimum": -10000,
                  "type": "number"
                },
                {
                  "maximum": 10000,
                  "minimum": -10000,
                  "type": "number"
                },
                {
                  "maximum": 10000,
                  "minimum": -10000,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "rotation_degrees": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "maximum": 10000,
                  "minimum": -10000,
                  "type": "number"
                },
                {
                  "maximum": 10000,
                  "minimum": -10000,
                  "type": "number"
                },
                {
                  "maximum": 10000,
                  "minimum": -10000,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Degrees"
        }
      },
      "required": [
        "type",
        "object_id"
      ],
      "title": "TransformSet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "issue_indices": {
      "items": {
        "maximum": 2,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Issue Indices",
      "type": "array"
    },
    "explanation": {
      "maxLength": 600,
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "operations": {
      "items": {
        "discriminator": {
          "mapping": {
            "mesh.sections.set": "#/$defs/MeshSectionsSet",
            "transform.set": "#/$defs/TransformSet"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MeshSectionsSet"
          },
          {
            "$ref": "#/$defs/TransformSet"
          }
        ]
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    }
  },
  "required": [
    "issue_indices",
    "explanation",
    "operations"
  ],
  "title": "LocalRepair",
  "type": "object"
}
