          "title": "Center",
          "type": "array"
        },
        "radii": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 100,
              "minimum": 0.001,
              "type": "number"
            },
            {
              "maximum": 100,
              "minimum": 0.001,
