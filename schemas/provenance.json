{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-forge.local/schemas/provenance.json",
  "title": "Media Forge provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "asset_id", "parent_asset_ids", "operation", "intent", "model_id", "model_version", "weights_hash", "license", "runtime_adapter", "runtime_version", "tool_versions", "seed", "parameters", "reference_asset_hashes", "postprocessing", "validation", "warnings", "output_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^prov_[0-9a-f]{32}$"},
    "asset_id": {"type": "string", "pattern": "^asset_[0-9a-f]{32}$"},
    "parent_asset_ids": {"type": "array", "items": {"type": "string", "pattern": "^asset_[0-9a-f]{32}$"}},
    "operation": {"type": "string"},
    "intent": {"type": "string"},
    "model_id": {"type": "string"},
    "model_version": {"type": "string"},
    "weights_hash": {"type": "string"},
    "license": {"type": "string"},
    "runtime_adapter": {"type": "string"},
    "runtime_version": {"type": "string"},
    "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "seed": {"type": "integer", "minimum": 0},
    "parameters": {"type": "object"},
    "reference_asset_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "postprocessing": {"type": "array", "items": {"type": "string"}},
    "validation": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
