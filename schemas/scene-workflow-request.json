{
  "$defs": {
    "AnimationClip": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "animation.clip",
          "title": "Type",
          "type": "string"
        },
        "object_id": {
          "description": "Stable recipe object ID used by all later operations; it is not a Blender name.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "clip_id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]*$",
          "title": "Clip Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "fps": {
          "default": 24,
          "maximum": 60,
          "minimum": 1,
          "title": "Fps",
          "type": "integer"
        },
        "frame_count": {
          "maximum": 600,
          "minimum": 1,
          "title": "Frame Count",
          "type": "integer"
        },
        "loop": {
          "default": false,
          "title": "Loop",
          "type": "boolean"
        },
        "replace": {
          "default": false,
          "title": "Replace",
          "type": "boolean"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/AnimationTrack"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "type",
        "object_id",
        "clip_id",
        "name",
        "frame_count",
        "tracks"
      ],
      "title": "AnimationClip",
      "type": "object"
    },
    "AnimationTrack": {
      "additionalProperties": false,
      "properties": {
        "bone_id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9._-]*$",
          "title": "Bone Id",
          "type": "string"
