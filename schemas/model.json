{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-forge.local/schemas/model.json",
  "title": "Media Forge model catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family",
    "version",
    "revision",
    "license",
    "runtime_adapter",
    "capabilities",
    "state",
    "installed",
    "healthy",
    "measured_vram_bytes",
    "measured_runtime_sec",
    "measurement_confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "runtime_adapter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "hardware_backends": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "general",
          "anime",
          "illustration",
          "photoreal",
          "game2d",
          "poster",
          "character_sheet",
          "background"
        ]
      }
    },
    "media_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "image",
          "video",
          "audio_video"
        ]
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "approx_download_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "repo_id",
        "revision"
      ],
      "properties": {
        "kind": {
          "const": "huggingface"
        },
        "repo_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "ownership": {
      "enum": [
        "managed",
        "external"
      ]
    },
    "supports_lora": {
      "type": "boolean"
    },
    "max_references": {
      "type": "integer",
      "minimum": 0
    },
    "reference_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "style",
          "pose",
          "composition",
          "clothing",
          "palette",
          "prop",
          "environment"
        ]
      }
    },
    "supports_reference_strength": {
      "type": "boolean"
    },
    "recommended_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gated": {
      "type": "boolean"
    },
    "license_notice": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "state": {
      "enum": [
        "available",
        "unavailable",
        "experimental"
      ]
    },
    "installed": {
      "type": "boolean"
    },
    "healthy": {
      "type": "boolean"
    },
    "measured_vram_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "measured_runtime_sec": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "measurement_confidence": {
      "type": "string",
      "enum": [
        "low",
        "measured"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "model",
        "lora"
      ],
      "description": "LoRA は単体では生成できない。routing の候補にもならない。"
    },
    "base_model": {
      "type": "string",
      "maxLength": 64,
      "description": "その checkpoint / LoRA が属する系統。空は不明。"
    },
    "trigger_words": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 80
      },
      "description": "LoRA を効かせるために prompt へ入れる語。"
    }
  }
}
