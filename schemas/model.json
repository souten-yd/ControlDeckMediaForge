{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-forge.local/schemas/model.json",
  "title": "Media Forge model catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family",
    "version",
    "revision",
    "license",
    "runtime_adapter",
    "capabilities",
    "state",
    "installed",
    "healthy",
    "measured_vram_bytes",
    "measured_runtime_sec",
    "measurement_confidence"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "family": {"type": "string", "minLength": 1, "maxLength": 100},
    "version": {"type": "string", "minLength": 1, "maxLength": 100},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"type": "string", "minLength": 1, "maxLength": 100},
    "runtime_adapter": {"type": "string", "minLength": 1, "maxLength": 100},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100}
    },
    "state": {"enum": ["available", "unavailable", "experimental"]},
    "installed": {"type": "boolean"},
    "healthy": {"type": "boolean"},
    "measured_vram_bytes": {"type": ["integer", "null"], "minimum": 0},
    "measured_runtime_sec": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "measurement_confidence": {"type": "string", "enum": ["low", "measured"]}
  }
}
