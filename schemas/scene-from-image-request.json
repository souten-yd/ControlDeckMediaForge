{
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "input_asset_id": {
      "pattern": "^asset_[0-9a-f]{32}$",
      "title": "Input Asset Id",
      "type": "string"
    },
    "engine": {
      "default": "auto",
      "enum": [
        "auto",
        "trellis_cpp",
        "pixal3d"
      ],
      "title": "Engine",
      "type": "string"
    },
    "refine_with_pixal3d": {
      "default": false,
      "title": "Refine With Pixal3D",
      "type": "boolean",
      "description": "Also run the Pixal3D stage after trellis.cpp and publish its result as the next revision of the same scene. Much slower; Pixal3D runs at its own measured resolution. Check the 3d.image_to_3d capability before requesting it."
    },
    "resolution": {
      "default": 1024,
      "enum": [
        512,
        1024
      ],
      "title": "Resolution",
      "type": "integer"
    },
    "seed": {
      "default": 42,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "local_only": {
      "const": true,
      "default": true,
      "title": "Local Only",
      "type": "boolean"
    },
    "tags": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f/\\\\]+$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Tags",
      "type": "array"
    },
    "collection": {
      "default": "experiment",
      "maxLength": 120,
      "minLength": 1,
      "title": "Collection",
      "type": "string"
    },
    "retry_job_id": {
      "anyOf": [
        {
          "pattern": "^job_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Job Id"
    },
    "additional_views": {
      "items": {
        "$ref": "#/$defs/AdditionalGenerationView"
      },
      "maxItems": 3,
      "title": "Additional Views",
      "type": "array"
    },
    "view_camera": {
      "anyOf": [
        {
          "$ref": "#/$defs/GenerationViewCamera"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "name",
    "input_asset_id"
  ],
  "title": "SceneFromImageRequest",
  "type": "object",
  "description": "Generate an experimental 3D scene from an existing PNG, JPEG or WebP image Asset using a locally adopted runtime. Returns a detached Job; use media.job.status or media.job.cancel. Preserves the input image, publishes a validated Blender revision and GLB with lineage. Runs trellis.cpp by default; set refine_with_pixal3d to continue into Pixal3D. Check 3d.image_to_3d capability before calling. Structural validation does not guarantee visual quality. Additional views are experimental camera-conditioned Pixal3D multiview inputs; check the multiview capability. The primary image is front, followed by right, back, left. Each must be a distinct matted RGBA image on the same square canvas. These inputs do not use the single-image refinement chain.",
  "$defs": {
    "AdditionalGenerationView": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "right",
            "back",
            "left"
          ],
          "title": "Direction",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^asset_[0-9a-f]{32}$",
          "title": "Asset Id",
          "type": "string"
        }
      },
      "required": [
        "direction",
        "asset_id"
      ],
      "title": "AdditionalGenerationView",
      "type": "object"
    },
    "GenerationViewCamera": {
      "additionalProperties": false,
      "description": "Shared turntable camera assumptions; does not calibrate arbitrary photos.",
      "properties": {
        "fov_degrees": {
          "default": 20.0,
          "maximum": 160,
          "minimum": 1,
          "title": "Fov Degrees",
          "type": "number"
        },
        "distance": {
          "default": 3.1192049980163574,
          "maximum": 100,
          "minimum": 0.01,
          "title": "Distance",
          "type": "number"
        },
        "elevation_degrees": {
          "default": 0.0,
          "maximum": 45,
          "minimum": -45,
          "title": "Elevation Degrees",
          "type": "number"
        },
        "mesh_scale": {
          "default": 1.0,
          "maximum": 100,
          "minimum": 0.01,
          "title": "Mesh Scale",
          "type": "number"
        }
      },
      "title": "GenerationViewCamera",
      "type": "object"
    }
  }
}
