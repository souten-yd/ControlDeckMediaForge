{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-forge.local/schemas/job-request.json",
  "title": "Media Forge job request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "intent"
  ],
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "image.generate",
        "image.edit",
        "video.generate",
        "video.edit",
        "media.inspect",
        "asset.pack"
      ],
      "description": "image.generate creates a new image. image.edit changes an existing image. video.generate creates video from text or bounded key images. video.edit changes existing video. asset.pack bundles existing assets."
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "description": "Plain description of the subject and the purpose, in any language. Structural requirements belong in constraints.asset_brief, not in adjectives here: a request that said 'wide landscape' only in this field was produced as a square."
    },
    "inputs": {
      "type": "array",
      "maxItems": 32,
      "default": [],
      "items": {
        "$ref": "#/$defs/assetInput"
      }
    },
    "profile": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "default": null
    },
    "model_policy": {
      "type": "string",
      "enum": [
        "auto",
        "fast",
        "balanced",
        "quality",
        "low_vram",
        "manual"
      ],
      "default": "auto",
      "description": "Leave as 'auto' unless the person asked for a specific tradeoff. 'quality' and 'low_vram' are for when the task genuinely needs them; 'manual' additionally requires model_id and is for explicit user model selection only."
    },
    "model_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200,
      "default": null
    },
    "constraints": {
      "type": "object",
      "default": {},
      "description": "Free-form generation constraints. Explicit integer width/height here always win over anything inferred. Prefer describing purpose in constraints.asset_brief and letting Media Forge resolve the geometry.",
      "properties": {
        "width": {
          "type": "integer",
          "description": "Exact output width. Overrides every inferred geometry rule."
        },
        "height": {
          "type": "integer",
          "description": "Exact output height. Overrides every inferred geometry rule."
        },
        "asset_brief": {
          "$ref": "#/$defs/assetBrief"
        },
        "scene_texture": {
          "$ref": "#/$defs/sceneTextureRequest",
          "description": "Durable 3D Studio return context for an image.generate job. It does not grant scene mutation authority; applying the resulting immutable image still requires MaterialBinding against the current revision."
        }
      }
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "qa": {
      "$ref": "#/$defs/qa"
    },
    "local_only": {
      "const": true,
      "default": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {"enum": ["video.generate", "video.edit"]}
        },
        "required": ["operation"]
      },
      "then": {
        "required": ["output"],
        "properties": {
          "inputs": {"maxItems": 8},
          "output": {
            "properties": {
              "format": {"enum": ["mp4", "webm"]}
            },
            "required": ["format"]
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "properties": {
              "format": {"not": {"enum": ["mp4", "webm"]}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "video.edit"}},
        "required": ["operation"]
      },
      "then": {
        "properties": {"inputs": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "sceneTextureRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scene_id",
        "source_revision_id",
        "object_name",
        "material_slot",
        "channel",
        "uv_map"
      ],
      "properties": {
        "schema_version": {
          "const": "media-forge.scene-texture-request@1"
        },
        "scene_id": {
          "type": "string",
          "pattern": "^scene_[0-9a-f]{32}$"
        },
        "source_revision_id": {
          "type": "string",
          "pattern": "^revision_[0-9a-f]{32}$"
        },
        "object_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "material_slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "channel": {
          "enum": [
            "base_color",
            "roughness",
            "metallic",
            "normal",
            "emission"
          ]
        },
        "uv_map": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f]+$"
        }
      }
    },
    "assetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^asset_[0-9a-f]{32}$"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "png",
            "webp",
            "jpeg",
            "mp4",
            "webm",
            "zip"
          ],
          "default": "png"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 1
        }
      },
      "default": {}
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "type": "boolean",
          "default": true
        },
        "semantic": {
          "type": "boolean",
          "default": false
        },
        "max_regeneration_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0
        }
      },
      "default": {},
      "description": "Leave at the defaults for ordinary generation. semantic=true asks for a vision evaluation, which costs a model swap; max_regeneration_attempts bounds subjective retries only. Objective mismatches against the brief are always corrected or reported regardless of this budget."
    },
    "assetBrief": {
      "type": "object",
      "title": "What the asset is for",
      "description": "Purpose-level description. Media Forge resolves the canvas, aspect ratio and transparency from this deterministically, before generation, so a landscape requirement cannot silently come back square. Everything is optional; give what the consuming code actually requires.",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "background",
            "key_visual",
            "character_portrait",
            "sprite",
            "icon",
            "emblem",
            "texture",
            "ui_element",
            "general"
          ],
          "description": "Where the asset is used. This sets the default aspect ratio and whether transparency is required: 'emblem' and 'sprite' are drawn over something else and default to requiring alpha; 'background' fills a surface and defaults to landscape and opaque."
        },
        "target_surface": {
          "type": "string",
          "maxLength": 64,
          "description": "Where it will be shown, when known: web, game, m5, print."
        },
        "subject": {
          "type": "string",
          "maxLength": 2000
        },
        "composition_intent": {
          "type": "string",
          "maxLength": 2000,
          "description": "How the subject should sit in the frame."
        },
        "aspect_intent": {
          "type": "string",
          "enum": [
            "auto",
            "square",
            "landscape",
            "portrait",
            "ratio"
          ],
          "description": "Use 'ratio' together with aspect_ratio for an exact ratio."
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[0-9]{1,3}:[0-9]{1,3}$",
          "description": "Exact ratio such as '16:9'. Read the consuming layout rather than guessing."
        },
        "target_width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "target_height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "safe_areas": {
          "type": "array",
          "maxItems": 4,
          "description": "Regions to keep visually clear for something else, such as a title or HUD. Composition intent, not a pixel-level guarantee.",
          "items": {
            "$ref": "#/$defs/safeArea"
          }
        },
        "alpha_intent": {
          "type": "string",
          "enum": [
            "auto",
            "required",
            "forbidden"
          ],
          "description": "Set 'required' whenever the asset is drawn over something else. An overlay generated without transparency arrives as an opaque rectangle with visible edges."
        },
        "consistency_group": {
          "type": "string",
          "maxLength": 128,
          "description": "Share one name across sibling assets that must look like a set."
        },
        "hard_constraints": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          },
          "description": "Requirements that must not be traded away, such as 'no text in the image'."
        }
      }
    },
    "safeArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge"
      ],
      "properties": {
        "edge": {
          "type": "string",
          "enum": [
            "top",
            "bottom",
            "left",
            "right"
          ]
        },
        "fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.9,
          "default": 0.33
        },
        "purpose": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  },
  "description": "Ask for what the asset is FOR. Media Forge resolves the canvas, the prompt wording for whichever model is routed, and the model itself. Do not write provider-tuned prompts and do not name a model: an agent that knows one model's preferred phrasing produces worse output the day the routing changes.",
  "examples": [
    {
      "operation": "image.generate",
      "intent": "Night riverside fireworks festival for a game title screen",
      "constraints": {
        "asset_brief": {
          "role": "background",
          "target_surface": "game",
          "aspect_intent": "ratio",
          "aspect_ratio": "16:9",
          "safe_areas": [
            {
              "edge": "top",
              "fraction": 0.4,
              "purpose": "title and menu"
            }
          ],
          "alpha_intent": "forbidden",
          "consistency_group": "hanabi-title",
          "hard_constraints": [
            "no text in the image"
          ]
        }
      }
    },
    {
      "operation": "image.generate",
      "intent": "A single golden chrysanthemum firework as a title emblem",
      "constraints": {
        "asset_brief": {
          "role": "emblem",
          "alpha_intent": "required",
          "consistency_group": "hanabi-title"
        }
      }
    }
  ]
}
